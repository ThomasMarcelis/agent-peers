{
  "name": "agent-peers",
  "version": "1.0.0-rc.1",
  "description": "Local agent-to-agent messaging for Claude Code and Codex, with a Codex MCP server and Hermes plugin",
  "mcpName": "io.github.ThomasMarcelis/agent-peers",
  "license": "MIT",
  "author": "Thomas Marcelis",
  "homepage": "https://github.com/ThomasMarcelis/agent-peers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasMarcelis/agent-peers.git"
  },
  "bugs": {
    "url": "https://github.com/ThomasMarcelis/agent-peers/issues"
  },
  "keywords": [
    "hermes",
    "codex",
    "claude-code",
    "mcp",
    "mcp-server",
    "codex-cli",
    "hermes-plugin",
    "agent-to-agent",
    "agent-communication",
    "multi-agent",
    "cross-session",
    "agents",
    "ipc"
  ],
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "agent_peers/",
    "__init__.py",
    "plugin.yaml",
    "hermes-plugin/",
    "scripts/install-hermes-plugin.py",
    "docs/",
    "!docs/observatory-design.md",
    "!docs/design/",
    "CLAUDE-snippet.md",
    "CHANGELOG.md",
    "LICENSE",
    "after-install.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "agent-peers": "bin/agent-peers.mjs",
    "codex-peer": "src/codex-peer.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-timeout=60000 test/bind-retry.mjs test/delivery.mjs test/discovery.mjs test/hermes-bridge.mjs test/wire.mjs test/app-server.mjs test/codex-peer.mjs test/cli.mjs test/logging.mjs test/names.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live": "node test/live-matrix.mjs",
    "test:live:hermes": "node test/hermes-live.mjs",
    "prepublishOnly": "npm run check && npm test && npm run test:python && npm run test:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "ws": "^8",
    "zod": "^4"
  }
}
